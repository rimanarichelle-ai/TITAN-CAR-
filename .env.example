# ==============================================================================
# TITAN CARS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to '.env.local' for local development.
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# Gemini AI API Key (Server-side model generation requests)
# Required for server-side AI endpoints (/api/gemini/generate)
GEMINI_API_KEY=""

# Application Host Base URL
# Default: http://localhost:3000 (or your production deployment domain)
APP_URL="http://localhost:3000"
